import json
from pathlib import Path


WORKFLOW_STATE_FILE = Path(
    "output/workflow_state.json"
)


def save_workflow_state(
    status: str,
    approval=None,
):
    """
    Save the current workflow state.
    """

    WORKFLOW_STATE_FILE.parent.mkdir(
        parents=True,
        exist_ok=True,
    )

    state = {
        "status": status,
        "approval": approval,
    }

    WORKFLOW_STATE_FILE.write_text(
        json.dumps(
            state,
            indent=2,
        ),
        encoding="utf-8",
    )


def load_workflow_state() -> dict:
    """
    Load the current workflow state.
    """

    if not WORKFLOW_STATE_FILE.exists():
        return {
            "status": "NOT_STARTED",
            "approval": None,
        }

    return json.loads(
        WORKFLOW_STATE_FILE.read_text(
            encoding="utf-8"
        )
    )
